rules_version = '2';
// =====================================================================
// FIRESTORE SECURITY RULES — Abrarr Tallks Portfolio
// =====================================================================
// HOW TO DEPLOY:
//   1. Go to https://console.firebase.google.com/
//   2. Open your project → Firestore Database → Rules tab
//   3. Replace the existing rules with everything below
//   4. Click "Publish"
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // HELPER: is the signed-in user an authorised admin?
    // Add extra admin emails here AND in firebase-config.js > ADMIN_EMAILS
    // -----------------------------------------------------------------
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
            "abrar@abrartallks-portfolio.co.in"
            // "another-admin@example.com"
          ];
    }

    // -----------------------------------------------------------------
    // PROJECTS  — public read, admin write
    // Collection: /projects/{docId}
    // -----------------------------------------------------------------
    match /projects/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // UPDATES / ANNOUNCEMENTS — public read, admin write
    // Collection: /updates/{docId}
    // -----------------------------------------------------------------
    match /updates/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // SITE CONFIG (hero images, stats, company info)
    // Collection: /site/{docId}   (docs: "hero", "stats")
    // -----------------------------------------------------------------
    match /site/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // BLOG POSTS — public read, admin write
    // Collection: /blogs/{docId}
    // -----------------------------------------------------------------
    match /blogs/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------
    // DENY everything else by default
    // -----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
